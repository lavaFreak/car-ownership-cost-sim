cabal-version:      3.0
name:               car-ownership-cost-sim
version:            0.1.0.0
synopsis:           Monte Carlo car ownership cost simulation web app
description:        A Haskell web app for exploring realistic car ownership costs under uncertainty.
build-type:         Simple
license:            MIT
license-file:       LICENSE
author:             Garion
maintainer:         garion@example.com
category:           Web
extra-source-files:
    README.md
    docs/vehicle-data-sourcing.md
    static/index.html
    static/styles.css
    static/app.js

data-files:
    catalog/vehicle-catalog.json

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall

library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        CarOwnershipCostSim.Simulation
        CarOwnershipCostSim.Statistics
        CarOwnershipCostSim.Types
        CarOwnershipCostSim.VehicleCatalog
        CarOwnershipCostSim.VehiclePresets
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        random >=1.2 && <1.4

executable car-ownership-cost-sim
    import:           shared-properties
    autogen-modules:
        Paths_car_ownership_cost_sim
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:
        Paths_car_ownership_cost_sim
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        car-ownership-cost-sim,
        http-types >=0.12 && <0.13,
        random >=1.2 && <1.4,
        scotty >=0.22 && <0.23

test-suite car-ownership-cost-sim-test
    import:           shared-properties
    autogen-modules:
        Paths_car_ownership_cost_sim
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Paths_car_ownership_cost_sim
    build-depends:
        base >=4.18 && <4.21,
        car-ownership-cost-sim,
        HUnit >=1.6 && <1.7
