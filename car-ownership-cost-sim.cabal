cabal-version:      3.0
name:               car-ownership-cost-sim
version:            0.1.0.0
synopsis:           Monte Carlo car ownership cost simulation web app
description:        A Haskell web app for exploring realistic car ownership costs under uncertainty.
build-type:         Simple
license:            MIT
license-file:       LICENSE
author:             Garion
maintainer:         garion@example.com
category:           Web
extra-source-files:
    README.md
    docs/architecture-overview.md
    docs/simulation-model.md
    docs/api-reference.md
    docs/frontend-overview.md
    docs/testing-and-workflows.md
    catalog/vehicle-source-seeds.json
    catalog/vehicle-roster.json
    catalog/roster-batches/2023-mainstream.txt
    catalog/roster-batches/2024-mainstream.txt
    catalog/roster-batches/2025-mainstream.txt
    catalog/roster-batches/2026-mainstream.txt
    docs/vehicle-data-sourcing.md
    scripts/expand-roster-batch.sh
    static/index.html
    static/styles.css
    static/app.js
    test/fixtures/fueleconomy/vehicle-47097.xml
    test/fixtures/fueleconomy/vehicle-47339.xml
    test/fixtures/vpic/honda-2024-models.json
    test/fixtures/vpic/toyota-2024-models.json

data-files:
    catalog/vehicle-catalog.json
    catalog/vehicle-source-seeds.json
    catalog/vehicle-roster.json
    static/index.html
    static/styles.css
    static/app.js
    test/fixtures/fueleconomy/vehicle-47097.xml
    test/fixtures/fueleconomy/vehicle-47339.xml
    test/fixtures/vpic/honda-2024-models.json
    test/fixtures/vpic/toyota-2024-models.json

common shared-properties
    default-language: GHC2021
    ghc-options:
        -Wall

-- Core project library containing the simulation engine, catalog layer,
-- and reusable web app definition.
library
    import:           shared-properties
    hs-source-dirs:   src
    exposed-modules:
        CarOwnershipCostSim.Simulation
        CarOwnershipCostSim.Statistics
        CarOwnershipCostSim.Types
        CarOwnershipCostSim.VehicleCatalog
        CarOwnershipCostSim.VehicleCatalogDefaults
        CarOwnershipCostSim.VehicleCatalogImport
        CarOwnershipCostSim.VehiclePresets
        CarOwnershipCostSim.WebApp
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        async >=2.2 && <2.3,
        bytestring >=0.11 && <0.13,
        http-types >=0.12 && <0.13,
        process >=1.6 && <1.7,
        random >=1.2 && <1.4,
        scotty >=0.22 && <0.23,
        wai-extra >=3.1 && <3.2,
        wai >=3.2 && <3.3

executable car-ownership-cost-sim
    import:           shared-properties
    ghc-options:
        -threaded
    autogen-modules:
        Paths_car_ownership_cost_sim
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:
        Paths_car_ownership_cost_sim
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        car-ownership-cost-sim,
        http-types >=0.12 && <0.13,
        random >=1.2 && <1.4,
        scotty >=0.22 && <0.23,
        warp >=3.3 && <3.5

executable build-vehicle-catalog
    import:           shared-properties
    hs-source-dirs:   app
    main-is:          BuildCatalog.hs
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        car-ownership-cost-sim

executable discover-vehicle-roster
    import:           shared-properties
    hs-source-dirs:   app
    main-is:          DiscoverVehicleRoster.hs
    build-depends:
        base >=4.18 && <4.21,
        aeson >=2.1 && <2.3,
        car-ownership-cost-sim,
        bytestring >=0.11 && <0.13,
        time >=1.12 && <1.15

-- Unified regression suite covering the simulation model, catalog import path,
-- and in-process route behavior.
test-suite car-ownership-cost-sim-test
    import:           shared-properties
    autogen-modules:
        Paths_car_ownership_cost_sim
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        Paths_car_ownership_cost_sim
    build-depends:
        base >=4.18 && <4.21,
        car-ownership-cost-sim,
        HUnit >=1.6 && <1.7,
        aeson >=2.1 && <2.3,
        bytestring >=0.11 && <0.13,
        http-types >=0.12 && <0.13,
        wai >=3.2 && <3.3,
        wai-extra >=3.1 && <3.2
